    classDef sms fill:#FFF2D7,color:#5F4215,stroke:#D7A84B,stroke-width:2px;
    classDef core fill:#F2E0D8,color:#5A281C,stroke:#A85942,stroke-width:2px;
    classDef decision fill:#ffffff,color:#2D1B0E,stroke:#A85942,stroke-width:2px;
    classDef neutral fill:#F4F0ED,color:#55463D,stroke:#BBAEA7,stroke-width:1px;
    classDef tenant fill:#EDE7E1,color:#2D1B0E,stroke:#8D6E63,stroke-width:2px;
